# Local development secrets. Copy to .env and fill in.
# Never commit .env.
# Canonical AI env names (backend/worker only; never VITE_* / frontend):
#   AI_PROVIDER, OPENAI_MODEL, OPENAI_API_KEY,
#   AI_ASSISTANT_LOOP, AI_MAX_TOOL_ROUNDS, AI_MAX_TOOL_CALLS,
#   AI_TIMEOUT_SECONDS, AI_MAX_OUTPUT_TOKENS

OPENAI_API_KEY=
AI_PROVIDER=deterministic
OPENAI_MODEL=
AI_ASSISTANT_LOOP=conversational
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=512
# Model turns (complete + continue). Conversational default is 2 (tool + narration).
AI_MAX_TOOL_ROUNDS=2
# Executed tools per query. Conversational default is 1.
AI_MAX_TOOL_CALLS=1
