# Shared / internal profile secrets. Copy to .env.shared and fill in.
# Never commit .env.shared. Local docker-compose.yml may keep the demo DB password.

POSTGRES_PASSWORD=
RISKFORGE_API_TOKEN=
# Optional multi-principal map: alice:token-a,bob:token-b,demo:token-demo
# If a TOKENS secret also appears in RISKFORGE_API_TOKEN, the TOKENS principal wins.
RISKFORGE_API_TOKENS=
