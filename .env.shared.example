# Shared / internal profile secrets. Copy to .env.shared and fill in.
# Never commit .env.shared. Local docker-compose.yml may keep the demo DB password.

POSTGRES_PASSWORD=
QUANTLINEAGE_API_TOKEN=
# Optional multi-principal map: alice:token-a,bob:token-b,demo:token-demo
# If a TOKENS secret also appears in QUANTLINEAGE_API_TOKEN, the TOKENS principal wins.
QUANTLINEAGE_API_TOKENS=

# OpenAI risk assistant (backend only; set via platform secret store in production)
OPENAI_API_KEY=
AI_PROVIDER=deterministic
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_TOOL_ROUNDS=1
